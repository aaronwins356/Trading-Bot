# Copy to .env (never commit it). Only the variables you use are needed.

# API / dashboard auth - required when binding to anything other than 127.0.0.1
TRADEBOT_API_TOKEN=change-me-to-a-long-random-string

# Exchange keys for LIVE bots (names are referenced from config: exchange.api_key_env / secret_env)
# Create trade-only keys: NO withdrawal permission, IP-whitelisted.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# Optional overrides
# TRADEBOT_DATA_DIR=./data
# TRADEBOT_DB_URL=postgresql+psycopg://user:pass@localhost/tradebot
# JEV_API_KEY=   # only for hosted OpenAI-compatible open-model APIs; Ollama needs none
